<div class="container mb-3 d-flex justify-content-end">
  <%= link_to new_event_path, class: "brico fs-5 fw-bold btn btn-primary shadow-pri" do %>
    NEW EVENT
  <% end %>
</div>

<div class="container brico fs-4 shadow-pri">

  <table class="table">
    <thead>
      <tr>
        <th scope="col">
          <%= link_to new_event_path, class: "text-decoration-none" do %>
            +
          <% end %>
        </th>
        <th scope="col">Event</th>
        <th scope="col">Where</th>
        <th scope="col">When</th>
        <th scope="col">
          Description
        </th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |e| %>
        <tr>
          <th scope="row">
            <%= image_tag e.image, class: "small avatar" %>
          </th>
          
          <td>
            <%= link_to e, class: "link-body-emphasis text-decoration-none" do %>
              <%= truncate e.name, length: 21, separator: " " %>
            <% end %>
          </td>
          <td><%= e.location %></td>
          <td><%= day e %></td>
          <td>
            <%= truncate e.description, length: 35, separator: " " %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>